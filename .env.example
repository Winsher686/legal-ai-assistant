# ============================================================
# 企业法务知识库与法规制度智能问答系统 —— 环境变量模板
# 复制为 .env 并填入真实值。生产服务器部署时只需修改本文件。
# ============================================================

# ---------- 应用 ----------
APP_ENV=development
DEBUG=false
SECRET_KEY=please-change-to-a-random-secret-key

# ---------- Mock 降级 ----------
# 本地无 Milvus/Neo4j/LLM 时置为 true 可端到端跑通；生产环境置为 false
USE_MOCK=false

# ---------- LLM ----------
# provider: openai / deepseek / qwen / mock
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ---------- Embedding ----------
# provider: bge / openai / mock
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal123
POSTGRES_DB=legal_ai

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- Milvus ----------
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=legal_knowledge_base

# ---------- Neo4j ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ---------- Reranker（cross-encoder 精排） ----------
RERANKER_MODEL=BAAI/bge-reranker-large

# ---------- 限流 ----------
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
